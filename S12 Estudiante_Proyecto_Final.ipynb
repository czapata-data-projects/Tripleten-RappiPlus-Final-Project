    "# PASO 4 - Parte 1: Asignar cohorte según mes de registro\n",
    "# ======================\n",
    "query_cohortes = '''\n",
    "SELECT \n",
    "    id_usuario,\n",
    "    CAST(fecha_registro AS DATE) AS fecha_registro,\n",
    "   TO_CHAR(DATE_TRUNC('month', CAST(fecha_registro AS DATE)), 'YYYY-MM') AS cohorte\n",
    "FROM users\n",
    "ORDER BY cohorte;\n",
    "'''\n",
    "cohortes = pd.read_sql(query_cohortes, con=engine)\n",
    "cohortes.head()"
   ]

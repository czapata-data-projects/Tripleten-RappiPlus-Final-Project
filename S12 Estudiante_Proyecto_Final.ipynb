   "source": [
    "# PARTE 2: Conversiones\n",
    "# ======================\n",
    "\n",
    "query_conversion = '''\n",
    "WITH conteos AS (\n",
    "    SELECT\n",
    "        (SELECT COUNT(DISTINCT id_usuario) FROM events WHERE nombre_evento = 'first_visit') AS first_visit,\n",
    "        \n",
    "        (SELECT COUNT(DISTINCT a.id_usuario) FROM events a \n",
    "         WHERE a.nombre_evento = 'select_item'\n",
    "         AND a.id_usuario IN (SELECT id_usuario FROM events WHERE nombre_evento = 'first_visit')) AS select_item,\n",
    "        \n",
    "        (SELECT COUNT(DISTINCT a.id_usuario) FROM events a \n",
    "         WHERE a.nombre_evento = 'add_to_cart'\n",
    "         AND a.id_usuario IN (SELECT id_usuario FROM events WHERE nombre_evento = 'select_item')) AS add_to_cart,\n",
    "        \n",
    "        (SELECT COUNT(DISTINCT a.id_usuario) FROM events a \n",
    "         WHERE a.nombre_evento = 'begin_checkout'\n",
    "         AND a.id_usuario IN (SELECT id_usuario FROM events WHERE nombre_evento = 'add_to_cart')) AS begin_checkout,\n",
    "        \n",
    "        (SELECT COUNT(DISTINCT a.id_usuario) FROM events a \n",
    "         WHERE a.nombre_evento = 'add_payment_info'\n",
    "         AND a.id_usuario IN (SELECT id_usuario FROM events WHERE nombre_evento = 'begin_checkout')) AS add_payment_info,\n",
    "        \n",
    "        (SELECT COUNT(DISTINCT a.id_usuario) FROM events a \n",
    "         WHERE a.nombre_evento = 'purchase'\n",
    "         AND a.id_usuario IN (SELECT id_usuario FROM events WHERE nombre_evento = 'add_payment_info')) AS purchase\n",
    ")\n",
    "SELECT * FROM conteos;\n",
    "'''\n",
    "\n",
    "conversion = pd.read_sql(query_conversion, con=engine)\n",
    "conversion"
   ]
  },
